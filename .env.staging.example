# Plantilla para .env.staging.local (copiar y completar; no versionar el .local).
# Valores públicos del SDK web del proyecto Firebase de staging.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
# Staging apunta al proyecto real de Firebase, no a los emuladores.
VITE_FIREBASE_USE_EMULATORS=false
