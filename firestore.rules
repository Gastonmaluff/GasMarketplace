rules_version = '2';

// ===============================================================
// GasMarketplace — Reglas de Firestore (fase de catálogo)
// ===============================================================
//
// Modelo asumido:
//
// settings/public   — configuración visible de la tienda (sin PII sensible).
// settings/private  — preferencias internas del panel.
// categories/{id}   — categorías; lectura pública solo con active == true.
// categorySlugs/{slug}      — índice de unicidad { categoryId }.
// products/{id}     — productos; lectura pública solo con active == true.
// productSlugs/{slug}       — índice de unicidad { productId }.
// productSkus/{sku}         — índice de unicidad { productId }.
// productBarcodes/{code}    — índice de unicidad { productId }.
// stockMovements/{id}       — ajustes/ventas/anulaciones de stock, inmutables.
// orders/{id}               — creados exclusivamente por la Cloud Function
//                              createOrder (Admin SDK, bypassa estas reglas);
//                              solo admin lee y transiciona el estado.
// orders/{id}/events/{id}   — historial del pedido; inmutable una vez creado.
// customers/{id}            — clientes derivados de pedidos; solo admin.
// counters/{id}             — correlativo anual de pedidos; solo la Function.
//
// Principios: default deny; administración exclusivamente por custom claim
// admin == true (asignado con Admin SDK, nunca escribible por clientes);
// esquema estricto con hasOnly; createdAt/createdBy inmutables; updatedAt
// y updatedBy validados contra request.time y el uid autenticado.
//
// Límite conocido: las reglas no pueden iterar arrays, por lo que el
// contenido interno de deliveryZones e images se valida en el cliente y
// solo su tamaño acá; ambas colecciones son de escritura exclusiva admin.
// El array `items` de orders no se valida acá por el mismo motivo: no hace
// falta, porque la única vía de creación (createOrder) ya lo calcula del
// lado del servidor y las reglas ni siquiera permiten un create directo.

service cloud.firestore {
  match /databases/{database}/documents {

    // ------------------------- Helpers -------------------------

    function isAdmin() {
      return request.auth != null && request.auth.token.admin == true;
    }

    function incoming() {
      return request.resource.data;
    }

    function auditedNow() {
      return incoming().updatedAt == request.time &&
        incoming().updatedBy == request.auth.uid;
    }

    function createdNow() {
      return incoming().createdAt == request.time &&
        incoming().createdBy == request.auth.uid;
    }

    function createdImmutable() {
      return incoming().createdAt == resource.data.createdAt &&
        incoming().createdBy == resource.data.createdBy;
    }

    function boundedString(value, maxLength) {
      return value is string && value.size() <= maxLength;
    }

    function requiredString(value, maxLength) {
      return value is string && value.size() > 0 && value.size() <= maxLength;
    }

    function intBetween(value, minValue, maxValue) {
      return value is int && value >= minValue && value <= maxValue;
    }

    function nullOrIntBetween(value, minValue, maxValue) {
      return value == null || intBetween(value, minValue, maxValue);
    }

    function validSlug(value) {
      return value is string && value.matches('[a-z0-9]+(-[a-z0-9]+)*') &&
        value.size() <= 80;
    }

    // ----------------------- settings ------------------------

    function isValidPublicSettings() {
      return incoming().keys().hasOnly([
          'storeName', 'storeDescription', 'whatsappNumberDisplay',
          'whatsappNumberNormalized', 'supportEmail', 'address', 'city',
          'country', 'currency', 'locale', 'timezone', 'pickupEnabled',
          'deliveryEnabled', 'acceptedPaymentMethods', 'deliveryZones',
          'orderConfirmationMessage', 'active', 'updatedAt', 'updatedBy'
        ]) &&
        requiredString(incoming().storeName, 80) &&
        boundedString(incoming().storeDescription, 500) &&
        boundedString(incoming().whatsappNumberDisplay, 30) &&
        boundedString(incoming().whatsappNumberNormalized, 20) &&
        boundedString(incoming().supportEmail, 120) &&
        boundedString(incoming().address, 200) &&
        boundedString(incoming().city, 80) &&
        boundedString(incoming().country, 60) &&
        incoming().currency == 'PYG' &&
        incoming().locale == 'es-PY' &&
        incoming().timezone == 'America/Asuncion' &&
        incoming().pickupEnabled is bool &&
        incoming().deliveryEnabled is bool &&
        incoming().acceptedPaymentMethods is list &&
        incoming().acceptedPaymentMethods.size() >= 1 &&
        incoming().acceptedPaymentMethods.size() <= 4 &&
        incoming().acceptedPaymentMethods.hasOnly(
          ['cash', 'bank_transfer', 'pay_on_pickup', 'cash_on_delivery']) &&
        incoming().deliveryZones is list &&
        incoming().deliveryZones.size() <= 20 &&
        boundedString(incoming().orderConfirmationMessage, 500) &&
        incoming().active is bool &&
        auditedNow();
    }

    function isValidPrivateSettings() {
      return incoming().keys().hasOnly([
          'internalOrderNotificationEmails', 'defaultLowStockThreshold',
          'allowNegativeStock', 'updatedAt', 'updatedBy'
        ]) &&
        incoming().internalOrderNotificationEmails is list &&
        incoming().internalOrderNotificationEmails.size() <= 10 &&
        intBetween(incoming().defaultLowStockThreshold, 0, 100000) &&
        incoming().allowNegativeStock is bool &&
        auditedNow();
    }

    match /settings/public {
      // Lectura pública únicamente de este documento exacto (storefront).
      allow read: if true;
      allow create, update: if isAdmin() && isValidPublicSettings();
      allow delete: if false;
    }

    match /settings/private {
      allow read: if isAdmin();
      allow create, update: if isAdmin() && isValidPrivateSettings();
      allow delete: if false;
    }

    // ----------------------- categories ----------------------

    function isValidCategory() {
      return incoming().keys().hasOnly([
          'name', 'normalizedName', 'slug', 'description', 'imageUrl',
          'imagePath', 'iconUrl', 'iconPath', 'order', 'active',
          'createdAt', 'createdBy', 'updatedAt', 'updatedBy'
        ]) &&
        requiredString(incoming().name, 80) &&
        boundedString(incoming().normalizedName, 80) &&
        validSlug(incoming().slug) &&
        boundedString(incoming().description, 500) &&
        boundedString(incoming().imageUrl, 2048) &&
        boundedString(incoming().imagePath, 300) &&
        boundedString(incoming().iconUrl, 2048) &&
        boundedString(incoming().iconPath, 300) &&
        intBetween(incoming().order, 0, 10000) &&
        incoming().active is bool &&
        auditedNow();
    }

    match /categories/{categoryId} {
      allow read: if isAdmin() || resource.data.active == true;
      allow create: if isAdmin() && isValidCategory() && createdNow();
      allow update: if isAdmin() && isValidCategory() && createdImmutable();
      allow delete: if isAdmin();
    }

    match /categorySlugs/{slug} {
      allow read: if isAdmin();
      allow create, update: if isAdmin() &&
        incoming().keys().hasOnly(['categoryId']) &&
        requiredString(incoming().categoryId, 100);
      allow delete: if isAdmin();
    }

    // ----------------------- suppliers -----------------------
    // Datos internos: nunca visibles para el storefront (solo admin).

    function isValidSupplier() {
      return incoming().keys().hasOnly([
          'name', 'normalizedName', 'contactName', 'phone', 'notes',
          'active', 'createdAt', 'createdBy', 'updatedAt', 'updatedBy'
        ]) &&
        requiredString(incoming().name, 120) &&
        boundedString(incoming().normalizedName, 120) &&
        boundedString(incoming().contactName, 120) &&
        boundedString(incoming().phone, 40) &&
        boundedString(incoming().notes, 500) &&
        incoming().active is bool &&
        auditedNow();
    }

    match /suppliers/{supplierId} {
      allow read: if isAdmin();
      allow create: if isAdmin() && isValidSupplier() && createdNow();
      allow update: if isAdmin() && isValidSupplier() && createdImmutable();
      allow delete: if isAdmin();
    }

    // ------------------------ products -----------------------

    function isValidProduct() {
      return incoming().keys().hasOnly([
          'name', 'normalizedName', 'slug', 'shortDescription', 'description',
          'sku', 'barcode', 'categoryIds', 'primaryCategoryId', 'price',
          'compareAtPrice', 'stock', 'lowStockThreshold',
          'trackStock', 'allowBackorder', 'images', 'featured', 'active',
          'searchTokens', 'createdAt', 'createdBy', 'updatedAt', 'updatedBy'
        ]) &&
        requiredString(incoming().name, 120) &&
        boundedString(incoming().normalizedName, 120) &&
        validSlug(incoming().slug) &&
        boundedString(incoming().shortDescription, 200) &&
        boundedString(incoming().description, 5000) &&
        boundedString(incoming().sku, 60) &&
        boundedString(incoming().barcode, 60) &&
        incoming().categoryIds is list &&
        incoming().categoryIds.size() <= 5 &&
        boundedString(incoming().primaryCategoryId, 100) &&
        (incoming().primaryCategoryId == '' ||
          incoming().categoryIds.hasAny([incoming().primaryCategoryId])) &&
        intBetween(incoming().price, 0, 1000000000) &&
        (incoming().compareAtPrice == null ||
          (incoming().compareAtPrice is int &&
            incoming().compareAtPrice > incoming().price &&
            incoming().compareAtPrice <= 1000000000)) &&
        intBetween(incoming().stock, -1000000, 1000000) &&
        nullOrIntBetween(incoming().lowStockThreshold, 0, 100000) &&
        incoming().trackStock is bool &&
        incoming().allowBackorder is bool &&
        incoming().images is list &&
        incoming().images.size() <= 10 &&
        incoming().featured is bool &&
        incoming().active is bool &&
        incoming().searchTokens is list &&
        incoming().searchTokens.size() <= 30 &&
        auditedNow();
    }

    match /products/{productId} {
      allow read: if isAdmin() || resource.data.active == true;
      allow create: if isAdmin() && isValidProduct() && createdNow();
      allow update: if isAdmin() && isValidProduct() && createdImmutable();
      allow delete: if isAdmin();
    }

    function isValidProductPrivate(productId) {
      return incoming().keys().hasOnly([
          'productId', 'costPrice', 'supplierId', 'supplierName', 'internalNotes',
          'createdAt', 'createdBy', 'updatedAt', 'updatedBy'
        ]) &&
        incoming().productId == productId &&
        nullOrIntBetween(incoming().costPrice, 0, 1000000000) &&
        boundedString(incoming().supplierId, 100) &&
        boundedString(incoming().supplierName, 160) &&
        boundedString(incoming().internalNotes, 1000) &&
        auditedNow();
    }

    match /productPrivate/{productId} {
      allow read: if isAdmin();
      allow create: if isAdmin() && isValidProductPrivate(productId) && createdNow();
      allow update: if isAdmin() && isValidProductPrivate(productId) && createdImmutable();
      allow delete: if isAdmin();
    }

    function isValidProductIndex() {
      return incoming().keys().hasOnly(['productId']) &&
        requiredString(incoming().productId, 100);
    }

    match /productSlugs/{slug} {
      allow read: if isAdmin();
      allow create, update: if isAdmin() && isValidProductIndex();
      allow delete: if isAdmin();
    }

    match /productSkus/{sku} {
      allow read: if isAdmin();
      allow create, update: if isAdmin() && isValidProductIndex();
      allow delete: if isAdmin();
    }

    match /productBarcodes/{barcode} {
      allow read: if isAdmin();
      allow create, update: if isAdmin() && isValidProductIndex();
      allow delete: if isAdmin();
    }

    // --------------------- stockMovements --------------------

    function isValidStockMovement() {
      return incoming().keys().hasOnly([
          'productId', 'type', 'orderId', 'quantity', 'previousStock', 'resultingStock',
          'reason', 'createdAt', 'createdBy'
        ]) &&
        requiredString(incoming().productId, 100) &&
        incoming().type in ['ajuste', 'venta', 'anulacion'] &&
        (!('orderId' in incoming()) || requiredString(incoming().orderId, 100)) &&
        incoming().quantity is int &&
        incoming().quantity != 0 &&
        intBetween(incoming().previousStock, -1000000, 1000000) &&
        intBetween(incoming().resultingStock, -1000000, 1000000) &&
        incoming().resultingStock == incoming().previousStock + incoming().quantity &&
        requiredString(incoming().reason, 300) &&
        createdNow();
    }

    match /stockMovements/{movementId} {
      allow read: if isAdmin();
      allow create: if isAdmin() && isValidStockMovement();
      // Los movimientos son un registro histórico: nunca se editan ni borran.
      allow update, delete: if false;
    }

    // ------------------------- orders -------------------------
    // Los pedidos contienen PII y montos: solo los crea la Cloud Function
    // createOrder (Admin SDK, que bypassa estas reglas por diseño). El panel
    // admin únicamente lee y transiciona el estado; items, totales y datos
    // del cliente quedan inmutables tras la creación.

    function canTransitionOrderStatus(from, to) {
      return (from == 'pendiente' && to in ['confirmado', 'cancelado']) ||
        (from == 'confirmado' && to in ['en_preparacion', 'cancelado']) ||
        (from == 'en_preparacion' && to in ['enviado', 'cancelado']) ||
        (from == 'enviado' && to == 'entregado');
    }

    function isValidOrderStatusTransition() {
      return incoming().diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt', 'updatedBy']) &&
        canTransitionOrderStatus(resource.data.status, incoming().status) &&
        auditedNow();
    }

    match /orders/{orderId} {
      allow read: if isAdmin();
      // Única vía de creación: la Cloud Function createOrder.
      allow create: if false;
      allow update: if isAdmin() && isValidOrderStatusTransition();
      allow delete: if false;

      function isValidOrderEvent() {
        return incoming().keys().hasOnly(
            ['type', 'fromStatus', 'toStatus', 'note', 'createdAt', 'createdBy']) &&
          incoming().type in ['creado', 'cambio_estado', 'nota'] &&
          (!('fromStatus' in incoming()) || boundedString(incoming().fromStatus, 20)) &&
          (!('toStatus' in incoming()) || boundedString(incoming().toStatus, 20)) &&
          (!('note' in incoming()) || boundedString(incoming().note, 500)) &&
          createdNow();
      }

      match /events/{eventId} {
        allow read: if isAdmin();
        allow create: if isAdmin() && isValidOrderEvent();
        // Historial inmutable: la Function crea "creado", el admin agrega
        // "cambio_estado"/"nota" al cambiar el estado; nunca se editan ni borran.
        allow update, delete: if false;
      }
    }

    // ----------------------- customers ------------------------

    function isValidCustomer() {
      return incoming().keys().hasOnly(
          ['phoneNormalized', 'phoneDisplay', 'name', 'email', 'ordersCount', 'totalSpent', 'lastOrderAt']) &&
        requiredString(incoming().phoneNormalized, 20) &&
        requiredString(incoming().phoneDisplay, 30) &&
        requiredString(incoming().name, 120) &&
        (!('email' in incoming()) || boundedString(incoming().email, 160)) &&
        intBetween(incoming().ordersCount, 0, 100000) &&
        intBetween(incoming().totalSpent, 0, 1000000000000) &&
        incoming().lastOrderAt is timestamp;
    }

    match /customers/{customerId} {
      allow read: if isAdmin();
      allow create, update: if isAdmin() && isValidCustomer();
      allow delete: if false;
    }

    // ------------------------ counters --------------------------
    // Correlativo anual de pedidos; solo lo incrementa la Cloud Function
    // createOrder dentro de la misma transacción que crea el pedido.

    match /counters/{counterId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // ----------------------- default deny --------------------

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
